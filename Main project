from tkinter import *

# Create window
root = Tk()
root.title("Unit Converter")
root.geometry("350x250")

# Variables
value = StringVar()
result = StringVar()
choice = StringVar()
choice.set("Celsius to Fahrenheit")

# Conversion function
def convert():
    try:
        num = float(value.get())

        if choice.get() == "Celsius to Fahrenheit":
            ans = (num * 9/5) + 32
            result.set(f"{ans:.2f} °F")
        else:
            ans = (num - 32) * 5/9
            result.set(f"{ans:.2f} °C")

    except ValueError:
        result.set("Invalid Input")

# UI
Label(root, text="Unit Converter", font=("Arial", 16, "bold")).pack(pady=10)

Entry(root, textvariable=value, font=("Arial", 12)).pack(pady=5)

OptionMenu(root, choice,
           "Celsius to Fahrenheit",
           "Fahrenheit to Celsius").pack(pady=5)

Button(root, text="Convert", command=convert).pack(pady=10)

Label(root, text="Result:", font=("Arial", 12)).pack()

Label(root, textvariable=result, font=("Arial", 14), fg="blue").pack()

root.mainloop()
